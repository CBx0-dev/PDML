{
    "name": "@pdml/vscode",
    "version": "1.0.0",
    "description": "VScode plugin for the PDML Language",
    "author": "CBx0",
    "publisher": "CBx0",
    "license": "Apache-2.0",
    "main": "./dist/main.js",
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "pdml",
        "syntax-highlighting",
        "language"
    ],
    "files": [
        "dist/**",
        "syntaxes/**",
        "language-configuration.json"
    ],
    "contributes": {
        "languages": [
            {
                "id": "pdml",
                "aliases": [
                    "PDML",
                    "pdml"
                ],
                "extensions": [
                    ".pdml"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pdml",
                "scopeName": "source.pdml",
                "path": "./syntaxes/pdml.tmLanguage.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "pdml",
                "scopes": {
                    "type": [
                        "entity.name.type.pdml"
                    ],
                    "type.declaration": [
                        "entity.name.type.declaration.pdml"
                    ],
                    "type.defaultLibrary": [
                        "support.type.primitive.pdml",
                        "entity.name.type.pdml"
                    ],
                    "property": [
                        "variable.other.property.pdml",
                        "entity.name.variable.field.pdml"
                    ],
                    "property.declaration": [
                        "variable.other.property.pdml",
                        "entity.name.variable.field.pdml"
                    ],
                    "keyword": [
                        "keyword.control.pdml"
                    ],
                    "operator": [
                        "keyword.operator.pdml"
                    ]
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run check",
        "check": "echo 'Checks defined'",
        "package": "vsce package",
        "compile": "tsc -p ./"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.15.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.15.0",
    "type": "module",
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.140.0",
        "@vscode/vsce": "^4.0.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "vscode-languageclient": "^11.0.0"
    }
}