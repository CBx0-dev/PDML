{
    "name": "pdml-language",
    "private": true,
    "displayName": "PDML",
    "version": "1.0.0",
    "description": "VS Code extension for the PDML Language",
    "author": "CBx0",
    "publisher": "CBx0",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/CBx0-dev/PDML.git"
    },
    "bugs": {
        "url": "https://github.com/CBx0-dev/PDML/issues"
    },
    "homepage": "https://github.com/CBx0-dev/PDML#readme",
    "main": "./dist/main.js",
    "engines": {
        "vscode": "^1.140.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "pdml",
        "syntax-highlighting",
        "language"
    ],
    "files": [
        "dist/**",
        "syntaxes/**",
        "language-configuration.json",
        "README.md",
        "LICENSE"
    ],
    "contributes": {
        "languages": [
            {
                "id": "pdml",
                "aliases": [
                    "PDML",
                    "pdml"
                ],
                "extensions": [
                    ".pdml"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pdml",
                "scopeName": "source.pdml",
                "path": "./syntaxes/pdml.tmLanguage.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "pdml",
                "scopes": {
                    "type": [
                        "entity.name.type.pdml"
                    ],
                    "type.declaration": [
                        "entity.name.type.declaration.pdml"
                    ],
                    "type.defaultLibrary": [
                        "support.type.primitive.pdml",
                        "entity.name.type.pdml"
                    ],
                    "property": [
                        "variable.other.property.pdml",
                        "entity.name.variable.field.pdml"
                    ],
                    "property.declaration": [
                        "variable.other.property.pdml",
                        "entity.name.variable.field.pdml"
                    ],
                    "keyword": [
                        "keyword.control.pdml"
                    ],
                    "operator": [
                        "keyword.operator.pdml"
                    ]
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run compile",
        "check": "echo 'Checks defined'",
        "package": "vsce package --no-dependencies",
        "compile": "rolldown -c"
    },
    "packageManager": "pnpm@12.15.0",
    "type": "module",
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.140.0",
        "@vscode/vsce": "^4.0.0",
        "rolldown": "^1.2.16",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "vscode-languageclient": "^11.0.0"
    }
}
